<script>
(function () {
  'use strict';

  /* ----- Affiliate link personalization ----- */
  // Read external_id and sub_id from current URL query string and inject into affiliate links
  (function personalizeAffiliateLinks() {
    var params = new URLSearchParams(window.location.search);
    var externalId = params.get('external_id') || params.get('External_ID_from_traffic_source') || '';
    var subId = params.get('sub_id') || params.get('subID') || '';

    document.querySelectorAll('a.affiliate-link').forEach(function (link) {
      var href = link.getAttribute('href');
      if (!href) return;
      // Replace placeholders if values are available
      if (externalId) href = href.replace('{External_ID_from_traffic_source}', encodeURIComponent(externalId));
      if (subId) href = href.replace('{subID}', encodeURIComponent(subId));
      // {sub} left as-is or can be mapped from another param if needed
      link.setAttribute('href', href);
    });
  })();

  /* ----- Sticky nav state ----- */
  var nav = document.getElementById('nav');
  function onScroll() {
    nav.classList.toggle('scrolled', window.scrollY > 10);
  }
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  /* ----- Mobile menu ----- */
  var toggle = nav.querySelector('.nav-toggle');
  toggle.addEventListener('click', function () {
    var open = nav.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
  });
  nav.querySelectorAll('.nav-links a').forEach(function (a) {
    a.addEventListener('click', function () {
      nav.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    });
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && nav.classList.contains('open')) {
      nav.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });

  /* ----- Scroll reveal ----- */
  var reveals = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });

    reveals.forEach(function (el, i) {
      el.style.transitionDelay = (i % 5) * 70 + 'ms';
      io.observe(el);
    });
  } else {
    reveals.forEach(function (el) { el.classList.add('in'); });
  }

  /* ----- Billing toggle ----- */
  var billing = document.getElementById('billing');
  var priceEls = document.querySelectorAll('.price b[data-monthly]');
  billing.addEventListener('change', function () {
    var annual = billing.checked;
    priceEls.forEach(function (el) {
      el.textContent = annual ? el.dataset.annual : el.dataset.monthly;
    });
  });

  /* ----- Signup form ----- */
  var form = document.getElementById('signup');
  var msg = document.getElementById('formMsg');
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var email = form.querySelector('input[name="email"]');
    var valid = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.value.trim());
    if (!valid) {
      msg.style.color = '#ff9b9b';
      msg.textContent = 'Please enter a valid work email.';
      email.focus();
      return;
    }
    msg.style.color = '#7ef0b6';
    msg.textContent = 'Thanks! Check ' + email.value.trim() + ' for your invite.';
    form.reset();
  });

  /* ----- Footer year ----- */
  document.getElementById('year').textContent = new Date().getFullYear();
})();
</script>
