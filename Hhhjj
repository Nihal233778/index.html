<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Lumen — Analytics that think ahead</title>
<meta name="description" content="Lumen turns raw product data into clear, real-time answers. Dashboards, cohorts and AI summaries your whole team can actually use." />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700&display=swap" rel="stylesheet">
<style>
/* ---------- Tokens ---------- */
:root{
  --bg:#08090d;
  --bg-2:#0b0d13;
  --surface:rgba(255,255,255,.035);
  --surface-2:rgba(255,255,255,.06);
  --border:rgba(255,255,255,.09);
  --border-strong:rgba(255,255,255,.16);
  --text:#eef0f6;
  --muted:#98a0b6;
  --accent:#7c6cff;
  --accent-2:#22d3ee;
  --radius:18px;
  --max:1140px;
  --ease:cubic-bezier(.2,.7,.3,1);
}

*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  margin:0;
  font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.65;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
body::before{
  content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;
  background:
    radial-gradient(58vw 55vw at 50% -18%, rgba(124,108,255,.24), transparent 65%),
    radial-gradient(42vw 42vw at 92% 6%, rgba(34,211,238,.12), transparent 62%),
    radial-gradient(48vw 40vw at 4% 34%, rgba(124,108,255,.09), transparent 62%);
}
h1,h2,h3,h4{font-family:Sora,Inter,sans-serif;line-height:1.12;letter-spacing:-.025em;margin:0;font-weight:700}
p{margin:0}
a{color:inherit}
img,svg{display:block;max-width:100%}
::selection{background:rgba(124,108,255,.4)}

/* ---------- Layout ---------- */
.wrap{width:100%;max-width:var(--max);margin-inline:auto;padding-inline:22px}
section{scroll-margin-top:96px}
.section{padding:clamp(64px,9vw,110px) 0}
.section-head{max-width:660px;margin:0 auto clamp(38px,5vw,60px);text-align:center}
.eyebrow{
  display:inline-block;font-size:.76rem;font-weight:600;letter-spacing:.14em;
  text-transform:uppercase;color:#a9a2ff;margin-bottom:14px;
}
.section-head h2{font-size:clamp(1.85rem,3.8vw,2.7rem)}
.section-head p{color:var(--muted);margin-top:16px;font-size:1.03rem}

/* ---------- Buttons ---------- */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:9px;
  padding:12px 20px;border-radius:12px;border:1px solid transparent;
  font:inherit;font-size:.94rem;font-weight:600;text-decoration:none;cursor:pointer;
  transition:transform .25s var(--ease),box-shadow .3s var(--ease),background .25s,border-color .25s,color .25s;
  white-space:nowrap;
}
.btn:focus-visible{outline:2px solid var(--accent-2);outline-offset:3px}
.btn-primary{
  background:linear-gradient(135deg,#8b7bff,#5b8cff 55%,#37c6e8);
  color:#fff;box-shadow:0 12px 34px -14px rgba(124,108,255,.95);
}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 20px 46px -16px rgba(124,108,255,1)}
.btn-ghost{background:rgba(255,255,255,.04);border-color:var(--border);color:var(--text)}
.btn-ghost:hover{background:rgba(255,255,255,.08);border-color:var(--border-strong)}
.btn-lg{padding:14px 26px;font-size:1rem;border-radius:14px}
.btn-block{width:100%}

/* ---------- Nav ---------- */
.nav{position:sticky;top:0;z-index:60;transition:background .3s,border-color .3s,backdrop-filter .3s;border-bottom:1px solid transparent}
.nav.scrolled{background:rgba(8,9,13,.72);backdrop-filter:blur(18px) saturate(150%);border-bottom-color:var(--border)}
.nav-inner{position:relative;display:flex;align-items:center;gap:26px;height:70px;max-width:var(--max);margin-inline:auto;padding-inline:22px}
.brand{display:flex;align-items:center;gap:10px;font-family:Sora,sans-serif;font-weight:700;font-size:1.08rem;letter-spacing:-.02em;text-decoration:none}
.brand-mark{
  width:26px;height:26px;border-radius:9px;flex:none;
  background:conic-gradient(from 210deg,#8b7bff,#37c6e8,#8b7bff);
  box-shadow:0 0 22px -4px rgba(124,108,255,.9),inset 0 0 0 1px rgba(255,255,255,.22);
}
.nav-links{display:flex;align-items:center;gap:4px;margin-right:auto}
.nav-links a{
  padding:9px 13px;border-radius:10px;font-size:.92rem;font-weight:500;
  color:var(--muted);text-decoration:none;transition:color .2s,background .2s;
}
.nav-links a:hover{color:var(--text);background:rgba(255,255,255,.06)}
.nav-actions{display:flex;align-items:center;gap:10px}
.nav-toggle{
  display:none;place-items:center;width:42px;height:42px;padding:0;margin-left:auto;
  border-radius:11px;border:1px solid var(--border);background:rgba(255,255,255,.04);
  color:var(--text);cursor:pointer;
}
.nav-toggle span{display:block;width:17px;height:1.6px;background:currentColor;border-radius:2px;transition:transform .3s var(--ease),opacity .2s}
.nav-toggle span+span{margin-top:4.5px}
.nav.open .nav-toggle span:nth-child(1){transform:translateY(6px) rotate(45deg)}
.nav.open .nav-toggle span:nth-child(2){opacity:0}
.nav.open .nav-toggle span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}

/* ---------- Hero ---------- */
.hero{position:relative;padding:clamp(58px,8vw,96px) 0 0;text-align:center}
.hero::before{
  content:"";position:absolute;inset:-70px 0 0;pointer-events:none;
  background-image:
    linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);
  background-size:64px 64px;
  -webkit-mask-image:radial-gradient(ellipse 70% 58% at 50% 0%,#000 20%,transparent 78%);
  mask-image:radial-gradient(ellipse 70% 58% at 50% 0%,#000 20%,transparent 78%);
}
.hero>*{position:relative}
.pill{
  display:inline-flex;align-items:center;gap:10px;padding:6px 15px 6px 7px;
  border-radius:999px;border:1px solid var(--border);background:rgba(255,255,255,.05);
  font-size:.82rem;color:var(--muted);text-decoration:none;
  transition:border-color .25s,background .25s;
}
.pill:hover{border-color:var(--border-strong);background:rgba(255,255,255,.08)}
.pill b{
  font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
  padding:3px 8px;border-radius:999px;color:#0a0b10;
  background:linear-gradient(135deg,#a89bff,#5ee7f5);
}
.hero h1{
  font-size:clamp(2.35rem,6.2vw,4.15rem);
  margin:26px auto 0;max-width:16ch;letter-spacing:-.035em;
}
.grad{
  background:linear-gradient(100deg,#b3a8ff,#5ee7f5 55%,#8b7bff);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.hero-sub{
  max-width:56ch;margin:22px auto 0;color:var(--muted);
  font-size:clamp(1rem,1.5vw,1.12rem);
}
.hero-actions{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:34px}
.hero-note{margin-top:18px;font-size:.83rem;color:#7d859c;display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
.hero-note span{display:inline-flex;align-items:center;gap:6px}
.tick{color:#5ee7a8;font-size:.95rem}

/* ---------- Product mock ---------- */
.mock-wrap{position:relative;margin-top:clamp(46px,6vw,72px);padding-bottom:clamp(24px,4vw,10px)}
.mock-wrap::before{
  content:"";position:absolute;inset:auto 8% -8%;height:60%;
  background:radial-gradient(ellipse at center,rgba(124,108,255,.4),transparent 70%);
  filter:blur(60px);pointer-events:none;
}
.mock{
  position:relative;border-radius:20px;overflow:hidden;
  border:1px solid rgba(255,255,255,.11);
  background:linear-gradient(180deg,rgba(21,23,34,.96),rgba(10,11,17,.98));
  box-shadow:0 50px 120px -50px rgba(124,108,255,.7),inset 0 1px 0 rgba(255,255,255,.07);
}
.mock-top{display:flex;align-items:center;gap:7px;padding:13px 16px;border-bottom:1px solid rgba(255,255,255,.07);background:rgba(255,255,255,.02)}
.dot{width:10px;height:10px;border-radius:50%;background:rgba(255,255,255,.16)}
.mock-url{
  margin:0 auto;padding:4px 16px;border-radius:999px;font-size:.72rem;
  color:#8b93a9;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.06);
}
.mock-grid{display:grid;grid-template-columns:184px 1fr;text-align:left}
.mock-side{padding:18px 12px;border-right:1px solid rgba(255,255,255,.07);display:grid;gap:4px;align-content:start}
.side-row{display:flex;align-items:center;gap:9px;padding:8px 10px;border-radius:9px;font-size:.8rem;color:#8b93a9}
.side-row i{width:13px;height:13px;border-radius:4px;background:rgba(255,255,255,.16);flex:none}
.side-row.active{background:rgba(124,108,255,.16);color:#d5d2ff}
.side-row.active i{background:linear-gradient(135deg,#a89bff,#5ee7f5)}
.mock-main{padding:22px 22px 24px;min-width:0}
.mock-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap}
.k{display:block;font-size:.74rem;letter-spacing:.07em;text-transform:uppercase;color:#7d859c}
.mock-head strong{font-family:Sora,sans-serif;font-size:1.85rem;letter-spacing:-.03em}
.badge-up{
  align-self:center;padding:5px 11px;border-radius:999px;font-size:.76rem;font-weight:600;
  color:#7ef0b6;background:rgba(94,231,168,.12);border:1px solid rgba(94,231,168,.26);
}
.chart{display:flex;align-items:flex-end;gap:7px;height:132px;margin-top:22px}
.chart span{
  flex:1;height:var(--h);border-radius:6px 6px 3px 3px;transform-origin:bottom;
  background:linear-gradient(180deg,rgba(124,108,255,.95),rgba(94,231,245,.22));
  animation:grow .85s var(--ease) both;
  animation-delay:calc(var(--i) * 45ms);
}
.chart span:nth-child(9),
.chart span:nth-child(11){
  background:linear-gradient(180deg,#5ee7f5,rgba(124,108,255,.3));
}
@keyframes grow{from{transform:scaleY(.04);opacity:.15}to{transform:scaleY(1);opacity:1}}
.mock-tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}
.tile{padding:12px 14px;border-radius:12px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06)}
.tile small{display:block;font-size:.68rem;color:#7d859c;letter-spacing:.05em;text-transform:uppercase}
.tile b{font-family:Sora,sans-serif;font-size:1rem;font-weight:600}
.tile b.up{color:#7ef0b6}

/* ---------- Logos ---------- */
.logos{padding:clamp(46px,6vw,64px) 0 0}
.logos p{text-align:center;font-size:.76rem;letter-spacing:.16em;text-transform:uppercase;color:#6f778e;margin-bottom:26px}
.logo-row{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:clamp(26px,5vw,60px)}
.logo-row span{
  font-family:Sora,sans-serif;font-size:1.05rem;font-weight:600;letter-spacing:-.02em;
  color:#8b93a9;opacity:.75;transition:opacity .25s,color .25s;
}
.logo-row span:hover{opacity:1;color:#cfd4e4}

/* ---------- Bento features ---------- */
.bento{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.card{
  position:relative;padding:26px;border-radius:var(--radius);
  background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.018));
  border:1px solid var(--border);overflow:hidden;
  transition:transform .35s var(--ease),border-color .35s,background .35s;
}
.card::after{
  content:"";position:absolute;inset:-1px;border-radius:inherit;pointer-events:none;
  background:radial-gradient(320px 140px at 20% 0%,rgba(124,108,255,.22),transparent 70%);
  opacity:0;transition:opacity .4s;
}
.card:hover{transform:translateY(-4px);border-color:var(--border-strong)}
.card:hover::after{opacity:1}
.card-lg{grid-column:span 2}
.card-icon{
  width:42px;height:42px;border-radius:12px;display:grid;place-items:center;margin-bottom:18px;
  background:rgba(124,108,255,.16);border:1px solid rgba(124,108,255,.32);color:#c3bcff;
}
.card-icon svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.card h3{font-size:1.12rem;margin-bottom:9px}
.card p{color:var(--muted);font-size:.93rem}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}
.chip{
  padding:6px 12px;border-radius:999px;font-size:.78rem;color:#c6cbe0;
  background:rgba(255,255,255,.05);border:1px solid var(--border);
}
.mini-bars{display:flex;align-items:flex-end;gap:6px;height:62px;margin-top:22px}
.mini-bars i{flex:1;border-radius:4px 4px 2px 2px;background:linear-gradient(180deg,rgba(124,108,255,.9),rgba(94,231,245,.25))}

/* ---------- Stats ---------- */
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.stat{
  padding:26px 22px;border-radius:var(--radius);text-align:center;
  background:rgba(255,255,255,.03);border:1px solid var(--border);
}
.stat b{display:block;font-family:Sora,sans-serif;font-size:clamp(1.5rem,2.6vw,2rem);letter-spacing:-.03em;
  background:linear-gradient(135deg,#dcd8ff,#8fe6f7);-webkit-background-clip:text;background-clip:text;color:transparent}
.stat span{display:block;font-size:.82rem;color:var(--muted);margin-top:6px}

/* ---------- Testimonials ---------- */
.quotes{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.quote{
  display:flex;flex-direction:column;gap:18px;padding:26px;border-radius:var(--radius);
  background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.018));
  border:1px solid var(--border);
}
.quote p{font-size:.96rem;color:#d6dae8}
.quote footer{display:flex;align-items:center;gap:11px;margin-top:auto}
.avatar{
  width:38px;height:38px;border-radius:50%;flex:none;display:grid;place-items:center;
  font-size:.8rem;font-weight:700;color:#0b0c12;
  background:linear-gradient(135deg,#a89bff,#5ee7f5);
}
.quote footer b{display:block;font-size:.88rem;font-weight:600}
.quote footer small{display:block;font-size:.78rem;color:#7d859c}
.stars{color:#ffcf6b;font-size:.85rem;letter-spacing:2px}

/* ---------- Pricing ---------- */
.billing{display:flex;align-items:center;justify-content:center;gap:14px;margin-bottom:38px;font-size:.9rem;color:var(--muted)}
.switch{position:relative;display:inline-block;width:52px;height:29px;flex:none}
.switch input{position:absolute;opacity:0;width:100%;height:100%;margin:0;cursor:pointer}
.slider{
  position:absolute;inset:0;border-radius:999px;background:rgba(255,255,255,.1);
  border:1px solid var(--border);transition:background .25s;
}
.slider::before{
  content:"";position:absolute;top:3px;left:3px;width:21px;height:21px;border-radius:50%;
  background:#fff;transition:transform .28s var(--ease);
}
.switch input:checked + .slider{background:linear-gradient(135deg,#8b7bff,#37c6e8)}
.switch input:checked + .slider::before{transform:translateX(23px)}
.switch input:focus-visible + .slider{outline:2px solid var(--accent-2);outline-offset:3px}
.save{
  padding:4px 10px;border-radius:999px;font-size:.74rem;font-weight:600;
  color:#7ef0b6;background:rgba(94,231,168,.12);border:1px solid rgba(94,231,168,.26);
}
.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;align-items:start}
.plan{
  padding:30px 26px;border-radius:var(--radius);border:1px solid var(--border);
  background:rgba(255,255,255,.03);display:flex;flex-direction:column;gap:18px;
}
.plan.featured{
  background:linear-gradient(180deg,rgba(124,108,255,.16),rgba(255,255,255,.03));
  border-color:rgba(124,108,255,.45);
  box-shadow:0 40px 90px -50px rgba(124,108,255,.9);
  position:relative;
}
.plan.featured::before{
  content:"Most popular";position:absolute;top:-11px;left:26px;
  padding:3px 11px;border-radius:999px;font-size:.7rem;font-weight:700;letter-spacing:.05em;
  text-transform:uppercase;color:#0a0b10;background:linear-gradient(135deg,#a89bff,#5ee7f5);
}
.plan h3{font-size:1.05rem}
.plan .desc{font-size:.86rem;color:var(--muted)}
.price{display:flex;align-items:flex-end;gap:6px}
.price b{font-family:Sora,sans-serif;font-size:2.35rem;letter-spacing:-.04em;line-height:1}
.price span{font-size:.85rem;color:var(--muted);padding-bottom:5px}
.plan ul{list-style:none;margin:0;padding:0;display:grid;gap:10px;font-size:.89rem;color:#c6cbe0}
.plan li{display:flex;gap:9px;align-items:flex-start}
.plan li::before{content:"✓";color:#7ef0b6;font-weight:700;font-size:.9rem;line-height:1.5}
.plan .btn{margin-top:auto}

/* ---------- FAQ ---------- */
.faq{max-width:760px;margin-inline:auto;display:grid;gap:10px}
details{
  border-radius:14px;border:1px solid var(--border);
  background:rgba(255,255,255,.03);overflow:hidden;transition:border-color .25s,background .25s;
}
details[open]{border-color:var(--border-strong);background:rgba(255,255,255,.05)}
summary{
  list-style:none;cursor:pointer;padding:18px 22px;font-weight:600;font-size:.97rem;
  display:flex;align-items:center;justify-content:space-between;gap:16px;
}
summary::-webkit-details-marker{display:none}
summary::after{
  content:"+";font-size:1.25rem;font-weight:400;color:var(--muted);
  transition:transform .3s var(--ease);line-height:1;
}
details[open] summary::after{transform:rotate(45deg)}
details p{padding:0 22px 20px;color:var(--muted);font-size:.92rem;max-width:62ch}

/* ---------- CTA ---------- */
.cta{padding:clamp(56px,8vw,96px) 0}
.cta-inner{
  position:relative;overflow:hidden;text-align:center;
  padding:clamp(40px,6vw,68px) clamp(22px,4vw,56px);border-radius:26px;
  border:1px solid rgba(124,108,255,.32);
  background:
    radial-gradient(70% 130% at 50% 0%,rgba(124,108,255,.32),transparent 62%),
    linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.015));
  box-shadow:0 60px 120px -60px rgba(124,108,255,.9);
}
.cta-inner h2{font-size:clamp(1.8rem,4vw,2.7rem);max-width:20ch;margin-inline:auto}
.cta-inner p{color:var(--muted);margin-top:14px}
.cta-form{
  display:flex;gap:10px;max-width:470px;margin:28px auto 0;flex-wrap:wrap;
}
.cta-form input{
  flex:1 1 220px;min-width:0;padding:13px 16px;border-radius:12px;
  border:1px solid var(--border-strong);background:rgba(0,0,0,.35);color:var(--text);
  font:inherit;font-size:.93rem;transition:border-color .25s,box-shadow .25s;
}
.cta-form input::placeholder{color:#6f778e}
.cta-form input:focus{outline:none;border-color:rgba(124,108,255,.8);box-shadow:0 0 0 3px rgba(124,108,255,.18)}
.form-msg{margin-top:14px;font-size:.86rem;color:#7ef0b6;min-height:1.2em}

/* ---------- Footer ---------- */
footer.site{border-top:1px solid var(--border);padding:clamp(44px,6vw,64px) 0 30px;background:rgba(255,255,255,.015)}
.foot-grid{display:grid;grid-template-columns:1.6fr repeat(3,1fr);gap:36px}
.foot-brand p{color:var(--muted);font-size:.88rem;margin-top:14px;max-width:30ch}
.foot-col h4{font-size:.8rem;letter-spacing:.12em;text-transform:uppercase;color:#8b93a9;margin-bottom:14px;font-family:Inter,sans-serif;font-weight:600}
.foot-col a{display:block;padding:5px 0;font-size:.9rem;color:var(--muted);text-decoration:none;transition:color .2s}
.foot-col a:hover{color:var(--text)}
.foot-bottom{
  display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between;align-items:center;
  margin-top:46px;padding-top:22px;border-top:1px solid var(--border);
  font-size:.83rem;color:#6f778e;
}
.foot-social{display:flex;gap:16px}
.foot-social a{color:#6f778e;text-decoration:none;transition:color .2s}
.foot-social a:hover{color:var(--text)}
.disclosure{font-size:.78rem;color:#6f778e;margin-top:20px;max-width:80ch;line-height:1.5}

/* ---------- Reveal ---------- */
.reveal{opacity:0;transform:translateY(22px);transition:opacity .75s var(--ease),transform .75s var(--ease)}
.reveal.in{opacity:1;transform:none}

/* ---------- Responsive ---------- */
@media (max-width:960px){
  .bento{grid-template-columns:repeat(2,1fr)}
  .card-lg{grid-column:span 2}
  .quotes{grid-template-columns:1fr}
  .stats{grid-template-columns:repeat(2,1fr)}
  .foot-grid{grid-template-columns:1fr 1fr;gap:30px}
  .foot-brand{grid-column:span 2}
}
@media (max-width:860px){
  .nav-links{
    position:absolute;top:calc(100% - 4px);left:8px;right:8px;display:none;
    flex-direction:column;align-items:stretch;gap:2px;padding:10px;
    border-radius:16px;border:1px solid var(--border);
